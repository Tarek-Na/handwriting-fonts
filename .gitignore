# Large binaries: tracked on disk, not in git. Nothing here is deleted.
data/cache_local/
data/google-fonts/
data/fonts/
*.pt
*.otf
*.ttf
*.npy
*.npz
__pycache__/
*.pyc

# Real people's handwriting: private, and this repository is public. The
# photographs and every image cut or rendered from them stay on disk only;
# text and numeric reports about them are fine to commit.
/*.jpg
/*.jpeg
/*.png
output/AntoineHand/
output/JadHand/
output/myhand/
output/myhand_diag/**/*.png
output/holdout/
output/review/*.png
output/freehand_debug.png
output/row2_zoom.png

# NIST Special Database 19 (1.1 GB of archives): download it, do not commit it.
data/sd19/
output/writers/
output/finetune/
